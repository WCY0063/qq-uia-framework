<?xml version="1.0" encoding="utf-8"?>
<!--
  ui/config-ui.xaml - the layout of the framework's account configuration window.

  This is the ONE file in the framework that is not ASCII: it is UTF-8 with a BOM
  and carries the Chinese interface copy directly. run-tests.ps1 exempts it from
  the ASCII rule (that rule exists because PowerShell 5.1 decodes a BOM-less .ps1
  as ANSI, which cannot happen to a XAML resource read explicitly as UTF-8).

  Every control the script touches carries a Name; qq-config-ui.ps1 resolves them
  through FindName and refuses to start when one is missing. run-tests.ps1 asserts
  the two lists agree, so a rename here cannot silently break the UI.
  There is no code-behind and no x:Class: the scripting host (qq-config-ui.ps1)
  attaches the event handlers.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="QQ 账号配置 — qq-uia 框架"
    Height="780" Width="1280" MinHeight="620" MinWidth="1000"
    WindowStartupLocation="CenterScreen"
    FontFamily="Microsoft YaHei UI" FontSize="12">

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="220"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Row 0: running instances on the left, the account table on the right. -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.3*" MinWidth="360"/>
        <ColumnDefinition Width="1*" MinWidth="380"/>
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Column="0" Header="运行实例（只读，UIA 枚举，不聚焦、不点击、不输入）" Margin="0,0,5,6" Padding="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DataGrid Name="InstancesGrid" Grid.Row="0"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    RowHeight="22">
            <DataGrid.Columns>
              <DataGridTextColumn Header="PID" Binding="{Binding pid}" Width="64"/>
              <DataGridTextColumn Header="昵称" Binding="{Binding nick}" Width="110"/>
              <DataGridTextColumn Header="签名" Binding="{Binding signature}" Width="*"/>
              <DataGridCheckBoxColumn Header="在线" Binding="{Binding online}" Width="46"/>
              <DataGridCheckBoxColumn Header="树已激活" Binding="{Binding a11yActive}" Width="72"/>
              <DataGridTextColumn Header="节点数" Binding="{Binding nodeCount}" Width="62"/>
              <DataGridTextColumn Header="宽" Binding="{Binding width}" Width="50"/>
              <DataGridTextColumn Header="高" Binding="{Binding height}" Width="50"/>
              <DataGridTextColumn Header="缩放" Binding="{Binding scale}" Width="50"/>
              <DataGridTextColumn Header="绑定别名" Binding="{Binding alias}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Name="BtnRefresh" Content="刷新实例" Padding="12,4" MinWidth="90"/>
            <Button Name="BtnDoctor" Content="doctor 自检" Padding="12,4" MinWidth="90" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
      </GroupBox>

      <GroupBox Grid.Column="1" Header="账号配置（写回 config.json 的 accounts[]）" Margin="5,0,0,6" Padding="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DataGrid Name="AccountsGrid" Grid.Row="0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False" CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    RowHeight="22">
            <DataGrid.Columns>
              <DataGridTextColumn Header="默认" Binding="{Binding isDefault}" Width="44" IsReadOnly="True"/>
              <DataGridTextColumn Header="别名" Binding="{Binding alias}" Width="100"/>
              <DataGridTextColumn Header="昵称" Binding="{Binding nick}" Width="110"/>
              <DataGridTextColumn Header="QQ 号" Binding="{Binding qqId}" Width="80"/>
              <DataGridCheckBoxColumn Header="启用" Binding="{Binding enabled}" Width="44"/>
              <DataGridTextColumn Header="备注" Binding="{Binding note}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Name="BtnAddAccount" Content="添加" Padding="10,4" MinWidth="62"/>
            <Button Name="BtnRemoveAccount" Content="删除" Padding="10,4" MinWidth="62" Margin="8,0,0,0"/>
            <Button Name="BtnSetDefault" Content="设为默认" Padding="10,4" MinWidth="78" Margin="8,0,0,0"/>
            <Button Name="BtnUp" Content="上移" Padding="10,4" MinWidth="62" Margin="8,0,0,0"/>
            <Button Name="BtnDown" Content="下移" Padding="10,4" MinWidth="62" Margin="8,0,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <Button Name="BtnBindFromInstance" Content="从选中实例绑定昵称" Padding="10,4" MinWidth="150"/>
            <TextBlock Text="把左侧选中实例的昵称写入右侧选中账号（没有选中账号时新建一行）"
                       VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666666"/>
          </StackPanel>
        </Grid>
      </GroupBox>
    </Grid>

    <!-- Row 1: the settings the commands read out of config.json. -->
    <GroupBox Grid.Row="1" Header="基本设置" Margin="0,0,0,6" Padding="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="dpi.mode" VerticalAlignment="Center" Margin="0,3"/>
        <ComboBox Name="DpiModeCombo" Grid.Row="0" Grid.Column="1" Margin="4,3" Height="24">
          <ComboBoxItem Content="auto"/>
          <ComboBoxItem Content="fixed"/>
        </ComboBox>

        <TextBlock Grid.Row="0" Grid.Column="2" Text="dpi.scale (0.5-5.0)" VerticalAlignment="Center" Margin="12,3,0,3"/>
        <TextBox Name="DpiScaleBox" Grid.Row="0" Grid.Column="3" Margin="4,3" Height="24" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="0" Grid.Column="4" Text="timeouts.defaultSec" VerticalAlignment="Center" Margin="12,3,0,3"/>
        <TextBox Name="DefaultSecBox" Grid.Row="0" Grid.Column="5" Margin="4,3" Height="24" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="0" Grid.Column="6" Text="a11y.minNodes" VerticalAlignment="Center" Margin="12,3,0,3"/>
        <TextBox Name="MinNodesBox" Grid.Row="0" Grid.Column="7" Margin="4,3" Height="24" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="instances.minWindowWidth" VerticalAlignment="Center" Margin="0,3"/>
        <TextBox Name="MinWidthBox" Grid.Row="1" Grid.Column="1" Margin="4,3" Height="24" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="1" Grid.Column="2" Text="guards.minSendIntervalMs" VerticalAlignment="Center" Margin="12,3,0,3"/>
        <TextBox Name="MinSendIntervalBox" Grid.Row="1" Grid.Column="3" Margin="4,3" Height="24" VerticalContentAlignment="Center"/>

        <CheckBox Name="RequireAccountMatchCheck" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2"
                  Content="guards.requireAccountMatch（强制 -ExpectAccountNick）"
                  VerticalAlignment="Center" Margin="12,3,0,3"/>

        <CheckBox Name="WriteAuditCheck" Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="3"
                  Content="evidence.writeAudit（写审计日志，发送冷却依赖它）"
                  VerticalAlignment="Center" Margin="12,3,0,3"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="QQ 可执行文件（仅用于生成启动命令）" VerticalAlignment="Center" Margin="0,3"/>
        <TextBox Name="QQPathBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="8" Margin="4,3" Height="24" VerticalContentAlignment="Center"/>
      </Grid>
    </GroupBox>

    <!-- Row 2: the actions. -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
      <Button Name="BtnSave" Content="保存配置" Padding="14,5" MinWidth="96"/>
      <Button Name="BtnReload" Content="重新加载" Padding="14,5" MinWidth="96" Margin="8,0,0,0"/>
      <Button Name="BtnOpenEvidence" Content="打开 evidence 目录" Padding="14,5" MinWidth="130" Margin="8,0,0,0"/>
      <Button Name="BtnCopyLaunch" Content="复制无障碍启动命令" Padding="14,5" MinWidth="150" Margin="8,0,0,0"/>
      <TextBlock Text="（只复制到剪贴板，框架从不启动 QQ 进程）"
                 VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666666"/>
    </StackPanel>

    <!-- Row 3: config path, unsaved marker, doctor summary. -->
    <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA" Padding="6,4">
      <TextBlock Name="StatusText" TextWrapping="Wrap" Text="就绪"/>
    </Border>
  </Grid>
</Window>
